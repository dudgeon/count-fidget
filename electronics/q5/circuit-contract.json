  "firmware_requirements": {
    "display_reset": "Push-pull whilepowered; all five display signals highimpedance beforemoduleoff.",
    "fram": "PB8CS open-drain;100us releaseguardwith<=100pFnet; allmemoryinternalpullsdisabled;20msstartupsettle; guardedwakefromsleep.",
    "boot": "BOOT0high+nBOOT1enabled+NRST orpowercycle; reservePA2/PA3/PA9/PA10fromloadenable.",
    "brownout": "BOR4 and PVD5; calibratedADC OLED ON>=3080mV/OFF<=3070mV with2% bounded estimation budget; periodic checks, recoverable reinitialization; not an arbitrary-collapse guarantee.",
    "power_latch": "PB2 push-pull HIGH as the first GPIO action; released for power-off after the display is off, FRAM asleep and the journal settled; Stop fallback with PB2 low when USB or a held key keeps U7 on; re-assert in the key EXTI handler.",
    "battery": "PA4 ADC_IN4 reads SYS_LOAD/2 with VREFINT-derived VDDA; >=4350 mV means charger-regulated SYS (USB), never a cell reading; LO below 3550 mV; save and power off after 6 consecutive samples below 3350 mV, after 2 s of LO.",
    "charger_status": "PA5/PA6 inputs with internal pull-ups only while awake; BQ25185 Table 6-2 decoding.",
    "keys": "Count reset only on release after a 2-10 s debounced hold with no COUNT activity; COUNT wins; keys held at boot are levels, not presses; the power-on COUNT press counts once (POR flag and COUNT_N low at setup).",
    "options": "If OPTR differs from the reviewed USER half-word only in BOR_LEV/BFB2/nBOOT1, program 0x807C once and OBL_LAUNCH; never write RDP; otherwise show OPT and never access FRAM."
  },
  "limitations": [
    "Not a hardware proof or manufacturing release.",
    "Regulated DC rail corners pass the conditional budget; dropout recovery overshoot, very-light-load accuracy and actual module current still need measurement.",
    "Mandatoryupstreamcapacitorinrush andUSB recovery notvalidated.",
    "Pinreviewmustbecomparedwithactualnative footprintpadnumbers, notjustmodelagreement.",
    "Soft-power latch timing, ON-node leakage and power-down ramps are unmeasured.",
    "Board-mounted NTC senses holder/board temperature, not the cell core."
  ]
